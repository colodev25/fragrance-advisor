# Modello pubblico senza credenziali. Copiare in .env solo se non esiste già.
# Per il server locale caricare prima degli import: uvicorn src.main:app --env-file .env --workers 1
# Render: inserire i valori in Environment, senza caricare il file nel repository.
GROQ_API_KEY=
SHOPIFY_STORE_URL=https://etualy.com
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Origini per sviluppo locale; in produzione usare soltanto quelle approvate.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SESSIONS_DB_PATH=data/sessions.db
# Solo dopo aver configurato un disco persistente su Render:
# SESSIONS_DB_PATH=/var/data/sessions.db

RATE_LIMIT_ENABLED=true
CHAT_RATE_LIMIT_PER_MINUTE=30
RESET_RATE_LIMIT_PER_MINUTE=10
API_MAX_BODY_BYTES=16384
API_BODY_TIMEOUT_SECONDS=5
API_MAX_CONCURRENT_REQUESTS=2
GROQ_CHAT_CALLS_PER_MINUTE=20
GROQ_CHAT_COOLDOWN_SECONDS=5

# Arricchimento catalogo; non sono i limiti della chat.
GROQ_CATALOG_MODEL=openai/gpt-oss-20b
GROQ_CATALOG_MAX_TOKENS=2048
GROQ_CATALOG_INTERVAL_SECONDS=2

# Non impostare FORWARDED_ALLOW_IPS senza verificare i proxy effettivamente fidati.
# RATE_LIMIT_TRUST_PROXY_HEADERS è deprecata e ignorata: non utilizzarla.
# Quote globali del provider e costi non vengono imposti da questo file.
